{
  "name": "Smart Email AI Reply Assistant",
  "description": "AI-Powered email reply generator",
  "version": "1.1",
  "manifest_version": 3,

  "permissions": [
    "activeTab",
    "storage"
  ],

  "host_permissions": [
    "http://localhost:8080/*",
    "*://mail.google.com/*"
  ],

  "action": {
    "default_title": "Smart Email AI Reply Assistant"
  },

  "options_page": "options.html",

 

  
"content_scripts": [
    {
        "js": [
            "content.js"
        ],
        "matches": [
            "*://mail.google.com/*"
        ],
        "css": [
            "content.css"
        ],
        "run_at": "document_end"
    }
],


  "web_accessible_resources": [
    {
      "resources": [
        "icons/*"
      ],
      "matches": [
        "*://mail.google.com/*"
      ]
    }
  ]
}

